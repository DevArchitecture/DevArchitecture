# Copy to .env and edit. `setup.sh` creates this file for you.
POSTGRES_DB=devarchitecture
POSTGRES_USER=devarch
POSTGRES_PASSWORD=change-me

# openssl rand -base64 48
TOKEN_OPTIONS_SECURITY_KEY=change-me-at-least-32-bytes

# Public host name. Use <public-ip>.sslip.io to get a free Let's Encrypt certificate,
# or your own domain pointed at the VM.
DOMAIN=203.0.113.10.sslip.io

# Host ports. Leave 80/443 on a real VM.
HTTP_PORT=80
HTTPS_PORT=443
